{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://s3-symbol-logo.tradingview.com; connect-src 'self' https://fapi.binance.com https://api.binance.com https://data-api.binance.vision https://api.bybit.com https://api.bytick.com https://contract.mexc.com https://api.mexc.com https://api.coingecko.com https://api.alternative.me https://api.telegram.org https://openapi.ctrader.com wss://fstream.binance.com wss://stream.binance.com:9443 wss://data-stream.binance.vision wss://stream.bybit.com wss://contract.mexc.com wss://live.ctraderapi.com:5036 wss://demo.ctraderapi.com:5036; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/proxy/mexc-priv/api/v1/private/:path*",
      "destination": "https://contract.mexc.com/api/v1/private/:path*"
    },
    {
      "source": "/proxy/mexc-fut/api/v1/contract/:path*",
      "destination": "https://contract.mexc.com/api/v1/contract/:path*"
    },
    {
      "source": "/proxy/mexc-spot/api/v3/:path*",
      "destination": "https://api.mexc.com/api/v3/:path*"
    },
    {
      "source": "/proxy/ff",
      "destination": "https://nfs.faireconomy.media/ff_calendar_thisweek.json"
    },
    {
      "source": "/proxy/earnings",
      "destination": "https://api.nasdaq.com/api/calendar/earnings"
    },
    {
      "source": "/proxy/ust/:type/:year",
      "destination": "https://home.treasury.gov/resource-center/data-chart-center/interest-rates/daily-treasury-rates.csv/:year/all?type=:type&field_tdr_date_value=:year&page&_format=csv"
    },
    {
      "source": "/proxy/cot",
      "destination": "https://publicreporting.cftc.gov/resource/6dca-aqww.json"
    },
    {
      "source": "/proxy/fred/series/observations",
      "destination": "https://api.stlouisfed.org/fred/series/observations"
    },
    {
      "source": "/proxy/rss/fxstreet",
      "destination": "https://www.fxstreet.com/rss/news"
    },
    {
      "source": "/proxy/rss/marketwatch",
      "destination": "https://feeds.content.dowjones.io/public/rss/mw_topstories"
    },
    {
      "source": "/proxy/rss/investing",
      "destination": "https://www.investing.com/rss/news_25.rss"
    },
    {
      "source": "/proxy/rss/coindesk",
      "destination": "https://www.coindesk.com/arc/outboundfeeds/rss/"
    }
  ]
}
